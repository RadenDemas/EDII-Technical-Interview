@model EDIITechincalInterview.Areas.Admin.ViewModels.BiodataEditViewModel

@{
    ViewData["Title"] = "Edit Biodata";
}

<div class="container mt-4">

    <h2>Edit Biodata</h2>
    <p class="text-muted">User: @Model.UserEmail</p>
    <hr />

    <form asp-action="Edit" method="post">
        
        <input type="hidden" asp-for="BiodataId" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="UserEmail" />

        <partial name="_Form" model="Model" />

        <partial name="_Pendidikan" model="Model" />

        <partial name="_Pelatihan" model="Model" />

        <partial name="_Pekerjaan" model="Model" />

        <div class="mt-4 mb-5">
            <button class="btn btn-primary">Simpan Perubahan</button>
            <a asp-action="Index" class="btn btn-secondary">Kembali</a>
        </div>

    </form>

</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/biodata.js"></script>
}

<style>
    .item-container .item-row:only-child .btn-hapus {
        display: none !important;
    }
</style>
