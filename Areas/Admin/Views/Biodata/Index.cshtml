@model List<EDIITechincalInterview.Areas.Admin.ViewModels.BiodataIndexItemViewModel>

@{
    ViewData["Title"] = "Kelola Biodata";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kelola Biodata</h2>
        <a asp-action="Create" class="btn btn-primary">Tambah Biodata Baru</a>
    </div>

    <form method="get" class="mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <input type="text" name="searchNama" value="@ViewData["searchNama"]" class="form-control" placeholder="Cari Nama..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="searchPosisi" value="@ViewData["searchPosisi"]" class="form-control" placeholder="Cari Posisi..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="searchPendidikan" value="@ViewData["searchPendidikan"]" class="form-control" placeholder="Cari Jenjang Pendidikan..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-secondary">Cari</button>
                <a asp-action="Index" class="btn btn-outline-danger">Reset</a>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>No</th>
                    <th>Nama Lengkap</th>
                    <th>Email / User</th>
                    <th>Posisi Dilamar</th>
                    <th>Pend. Terakhir</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.Nama</td>
                            <td>@item.Email</td>
                            <td>@item.PosisiDilamar</td>
                            <td>@item.PendidikanTerakhir</td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detail</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus biodata ini?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                                </form>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">Tidak ada data ditemukan.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
