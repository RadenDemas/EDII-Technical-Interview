@model EDIITechincalInterview.Areas.User.ViewModels.BiodataEditViewModel

@{
    ViewData["Title"] = "Edit Biodata";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit Biodata</h2>
        <a asp-action="Detail" class="btn btn-secondary">Batal / Kembali</a>
    </div>

    <hr />

    <form asp-action="Edit" method="post">
        
        <input type="hidden" asp-for="BiodataId" />

        <partial name="_Form" model="Model" />

        <partial name="_Pendidikan" model="Model" />

        <partial name="_Pelatihan" model="Model" />

        <partial name="_Pekerjaan" model="Model" />

        <div class="mt-4 mb-5">
            <button class="btn btn-primary btn-lg">
                Simpan Perubahan
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/biodata.js"></script>
}

<style>
    .item-container .item-row:only-child .btn-hapus {
        display: none !important;
    }
</style>
