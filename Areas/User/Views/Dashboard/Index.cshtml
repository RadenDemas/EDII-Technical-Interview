@{
    ViewData["Title"] = "User Dashboard";
    bool hasBiodata = ViewBag.HasBiodata ?? false;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body py-5">
                    <h2 class="display-6 fw-bold">Selamat Datang, @User.Identity?.Name!</h2>
                    <p class="lead mb-0">Ini adalah halaman dashboard khusus pengguna.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center py-5">
                    <h4 class="card-title mb-4">Status Biodata Anda</h4>
                    
                    @if (hasBiodata)
                    {
                        <div class="text-success mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                            </svg>
                        </div>
                        <h5 class="text-success fw-bold">Sudah Terisi</h5>
                        <p class="text-muted">Terima kasih, Anda telah melengkapi data biodata Anda.</p>
                        <a asp-area="User" asp-controller="Biodata" asp-action="Index" class="btn btn-outline-primary mt-3 px-4">Lihat / Edit Biodata</a>
                    }
                    else
                    {
                        <div class="text-warning mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                            </svg>
                        </div>
                        <h5 class="text-warning fw-bold">Belum Terisi</h5>
                        <p class="text-muted">Anda wajib melengkapi biodata untuk keperluan seleksi.</p>
                        <a asp-area="User" asp-controller="Biodata" asp-action="Create" class="btn btn-primary mt-3 px-4">Lengkapi Biodata Sekarang</a>
                    }
                </div>
            </div>
        </div>        
    </div>
</div>